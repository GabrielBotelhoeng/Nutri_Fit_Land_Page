# WhatsApp que recebe os CTAs (DDI+DDD+número, sem + nem espaços).
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000

# Marca exibida no Header/Footer/título. Padrão: NutriChat.
# NEXT_PUBLIC_NUTRI_MARCA=NutriChat

# Nutricionista parceiro — OPCIONAL e SÓ COM DADOS REAIS.
# Nome e CRN só aparecem na página quando os DOIS estão preenchidos.
# Nunca use nome ou CRN fictício: registro profissional inventado numa
# página pública é exercício irregular da profissão.
#
# Next.js embute NEXT_PUBLIC_* no build: depois de mudar, rebuild
# (npm run build) ou reinicie o dev server.
# NEXT_PUBLIC_NUTRI_NOME_COMPLETO=
# NEXT_PUBLIC_NUTRI_CRN=
# NEXT_PUBLIC_NUTRI_ESPECIALIDADE=Nutricionista
# NEXT_PUBLIC_NUTRI_INICIAIS=
